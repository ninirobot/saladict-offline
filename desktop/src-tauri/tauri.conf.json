{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SaladictLite",
  "version": "0.1.0",
  "identifier": "com.saladict.lite",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5183",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "沙拉划词",
        "width": 760,
        "height": 580,
        "minWidth": 700,
        "minHeight": 500,
        "center": true,
        "visible": false,
        "resizable": true,
        "decorations": true,
        "backgroundColor": "#F7F8FA"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' mdx: data: https: http:; media-src 'self' mdx: data: https: http:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; script-src 'self'; connect-src 'self' ipc: http://ipc.localhost"
    },
    "trayIcon": {
      "id": "saladict-tray",
      "iconPath": "icons/32x32.png",
      "iconAsTemplate": false,
      "tooltip": "沙拉划词"
    }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.ico"]
  }
}
