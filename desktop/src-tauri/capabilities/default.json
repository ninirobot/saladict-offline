{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "主窗口与浮窗所需的最小权限集",
  "windows": ["main", "popup"],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "core:window:allow-hide",
    "core:window:allow-close",
    "core:webview:allow-internal-toggle-devtools"
  ]
}
